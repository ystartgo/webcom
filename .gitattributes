# Auto detect text files and perform LF normalization
* text=auto

# Windows batch, shell and script files MUST preserve CRLF (never convert to LF)
*.bat -text
*.cmd -text
*.vbs -text
*.ps1 -text
*.reg -text

# Binary files
*.whl binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
*.wasm binary
*.png binary
*.jpg binary
*.ico binary
