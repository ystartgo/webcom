<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="WebcomTab" label="Webcom AI">
        <!-- 群組 1: 核心助理 -->
        <group id="grpCore" label="核心助理">
          <button id="btnOpenTaskpane" label="開啟 Webcom" size="large" onAction="OnAction" imageMso="FileSave" />
        </group>

        <!-- 群組 2: 智慧寫作 -->
        <group id="grpWrite" label="智慧寫作">
          <button id="btnWrite" label="幫我寫" size="large" onAction="OnAction" imageMso="BlogNewAccount" />
          <button id="btnContinue" label="續寫" size="normal" onAction="OnAction" imageMso="MacroPlay" />
          <button id="btnRewrite" label="重寫" size="normal" onAction="OnAction" imageMso="Redo" />
          <button id="btnExpand" label="擴寫" size="normal" onAction="OnAction" imageMso="FontGrow" />
          <button id="btnShrink" label="縮寫" size="normal" onAction="OnAction" imageMso="FontShrink" />
        </group>

        <!-- 群組 3: 潤飾與校對 -->
        <group id="grpPolish" label="潤飾校對">
          <button id="btnPolish" label="潤色" size="large" onAction="OnAction" imageMso="ReviewAcceptChange" />
          <button id="btnProofread" label="AI 校對" size="normal" onAction="OnAction" imageMso="Spelling" />
          <button id="btnImprove" label="改善寫作" size="normal" onAction="OnAction" imageMso="SmartArtChangeShapeGallery" />
          <button id="btnFormat" label="AI 排版" size="normal" onAction="OnAction" imageMso="PageSetupDialog" />
        </group>

        <!-- 群組 4: 文件問答與分析 -->
        <group id="grpDoc" label="文件問答分析">
          <button id="btnDocSummary" label="全文總結" size="large" onAction="OnAction" imageMso="AutoSummary" />
          <button id="btnDocQA" label="文件問答" size="normal" onAction="OnAction" imageMso="Help" />
          <button id="btnTranslate" label="對照翻譯" size="normal" onAction="OnAction" imageMso="TranslateWord" />
          <button id="btnContract" label="合約審查" size="normal" onAction="OnAction" imageMso="ReviewReviewingPane" />
          <button id="btnAcademic" label="學術助手" size="normal" onAction="OnAction" imageMso="FormulaInsertGallery" />
        </group>

        <!-- 群組 5: 語音朗讀 -->
        <group id="grpSpeech" label="語音朗讀">
          <button id="btnReadAloud" label="朗讀選取" size="large" onAction="OnAction" imageMso="Speech" />
          <button id="btnStopSpeech" label="停止朗讀" size="normal" onAction="OnAction" imageMso="StopRecording" />
        </group>

        <!-- 群組 6: 偏好設定 -->
        <group id="grpSettings" label="偏好設定">
          <button id="btnDeepThink" label="深度思考" size="normal" onAction="OnAction" imageMso="Calculator" />
          <button id="btnHistory" label="歷史會話" size="normal" onAction="OnAction" imageMso="History" />
          <button id="btnSettings" label="設置" size="normal" onAction="OnAction" imageMso="ControlProperties" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
