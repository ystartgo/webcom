{
  "manifest_version": 3,
  "name": "Webcom AI Console & Multi-Protocol Terminal",
  "version": "1.0.8",
  "description": "雙引擎邊緣 AI 控制台、多協定終端機 (Shell/SSH/Telnet/WebSerial) 與本機/WASM Python 運行環境",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "開啟 Webcom AI 控制台",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "contextMenus",
    "system.display"
  ],
  "optional_permissions": [
    "serial"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}